local rows = {}

local function refresh(plr)
    local r = rows[plr]
    if not r then return end
    if allies[plr] then
        r.BackgroundColor3 = Color3.fromRGB(38, 128, 62)
        r.Text = "  ALIADO   " .. plr.Name
    else
        r.BackgroundColor3 = Color3.fromRGB(120, 42, 42)
        r.Text = "  ENEMIGO  " .. plr.Name
    end
end

local function addRow(plr)
    if rows[plr] then return end
    local r = Instance.new("TextButton")
    r.Name = plr.Name
    r.Size = UDim2.new(1, -8, 0, 26)
    r.BackgroundColor3 = Color3.fromRGB(120, 42, 42)
    r.BorderSizePixel = 0
    r.TextColor3 = Color3.fromRGB(255, 255, 255)
    r.TextXAlignment = Enum.TextXAlignment.Left
    r.Font = Enum.Font.GothamMedium
    r.TextSize = 12
    r.Text = "  " .. plr.Name
    r.Parent = list
    corner(r, 6)
    rows[plr] = r

    r.MouseButton1Click:Connect(function()
        if allies[plr] then
            allies[plr] = nil
        else
            allies[plr] = true
        end
        refresh(plr)
    end)

    refresh(plr)
end

local function buildList()
    for _, r in pairs(rows) do r:Destroy() end
    rows = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Players.LocalPlayer then
            addRow(plr)
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    addRow(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    if rows[plr] then
        rows[plr]:Destroy()
        rows[plr] = nil
    end
    allies[plr] = nil
end)

markTeamBtn.MouseButton1Click:Connect(function()
    local lp = Players.LocalPlayer
    if not lp.Team then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Team == lp.Team then
            allies[plr] = true
            refresh(plr)
        end
    end
end)

clearBtn.MouseButton1Click:Connect(function()
    for plr in pairs(allies) do
        allies[plr] = nil
    end
    for plr in pairs(rows) do
        refresh(plr)
    end
end)

--=========================== INPUT GLOBAL ===========================
UserInputService.InputBegan:Connect(function(input, gp)
    -- Modo rebindeo: captura la siguiente tecla
    if listening then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if input.KeyCode == Enum.KeyCode.Escape then
            listening = nil
        elseif input.KeyCode == Enum.KeyCode.Unknown then
            return
        else
            if listening == "gui" then
                if input.KeyCode == ToggleKey then ToggleKey = guiKey end
                guiKey = input.KeyCode
            else
                if input.KeyCode == guiKey then guiKey = ToggleKey end
                ToggleKey = input.KeyCode
            end
            listening = nil
        end

        refreshKeys()
        return
    end

    -- Abrir/cerrar GUI con la tecla configurada
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == guiKey then
        main.Visible = not main.Visible
    end
end)

