local rows = {}

local function refreshRow(target)
    local r = rows[target]
    local data = espData[target]
    if not r or not data then return end
    if data.enabled then
        r.BackgroundColor3 = Color3.fromRGB(38, 128, 62)
        r.Text = "  ESP ON   " .. target.Name
    else
        r.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
        r.Text = "  ESP OFF  " .. target.Name
    end
end

addPlayerRow = function(target)
    if rows[target] then return end
    local r = Instance.new("TextButton")
    r.Name = target.Name
    r.Size = UDim2.new(1, -8, 0, 26)
    r.BackgroundColor3 = Color3.fromRGB(38, 128, 62)
    r.BorderSizePixel = 0
    r.TextColor3 = Color3.fromRGB(255, 255, 255)
    r.TextXAlignment = Enum.TextXAlignment.Left
    r.Font = Enum.Font.GothamMedium
    r.TextSize = 12
    r.Text = "  " .. target.Name
    r.Parent = list
    corner(r, 6)
    rows[target] = r

    r.MouseButton1Click:Connect(function()
        local data = espData[target]
        if data then
            data.enabled = not data.enabled
            refreshRow(target)
        end
    end)

    refreshRow(target)
end

removePlayerRow = function(target)
    if rows[target] then
        rows[target]:Destroy()
        rows[target] = nil
    end
end

--=========================== INPUT GLOBAL ===========================
UserInputService.InputBegan:Connect(function(input)
    if listening then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if input.KeyCode == Enum.KeyCode.Escape then
            listening = false
        elseif input.KeyCode ~= Enum.KeyCode.Unknown then
            guiKey = input.KeyCode
            listening = false
        else
            return
        end

        refreshKeyBtn()
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == guiKey then
        main.Visible = not main.Visible
    end
end)

-- Arrastrar la ventana
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

