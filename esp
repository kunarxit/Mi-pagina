--==================================================================
-- NUCLEO DEL ESP
--==================================================================
local function createESP(target)
    if target == plr or espData[target] then return end

    local lines = {}
    for i = 1, 4 do
        local l = Drawing.new("Line")
        l.Visible = false
        l.From = Vector2.new(0, 0)
        l.To = Vector2.new(0, 0)
        l.Color = settings.enemyColor
        l.Thickness = settings.thickness
        l.Transparency = settings.transparency
        lines[i] = l
    end

    espData[target] = { lines = lines, enabled = true }

    if addPlayerRow then
        addPlayerRow(target)
    end
end

local function removeESP(target)
    local data = espData[target]
    if not data then return end
    for _, l in ipairs(data.lines) do
        l:Remove()
    end
    espData[target] = nil
end

local function updateESP()
    for target, data in pairs(espData) do
        local lines = data.lines
        local char = target.Character

        local ok = settings.enabled
            and data.enabled
            and target ~= plr
            and char ~= nil
            and char:FindFirstChild("HumanoidRootPart") ~= nil
            and char:FindFirstChild("Head") ~= nil
            and char:FindFirstChild("Humanoid") ~= nil
            and char.Humanoid.Health > 0

        if ok and settings.ignoreAllies and target.TeamColor == plr.TeamColor then
            ok = false
        end

        if ok then
            local root = char.HumanoidRootPart
            local ScreenPos, OnScreen = camera:WorldToViewportPoint(root.Position)

            if OnScreen then
                local Scale = char.Head.Size.Y / 2
                local Size = Vector3.new(2, 3, 0) * (Scale * 2)

                local TL = camera:WorldToViewportPoint((root.CFrame * CFrame.new(Size.X, Size.Y, 0)).p)
                local TR = camera:WorldToViewportPoint((root.CFrame * CFrame.new(-Size.X, Size.Y, 0)).p)
                local BL = camera:WorldToViewportPoint((root.CFrame * CFrame.new(Size.X, -Size.Y, 0)).p)
                local BR = camera:WorldToViewportPoint((root.CFrame * CFrame.new(-Size.X, -Size.Y, 0)).p)

                lines[1].From = Vector2.new(TL.X, TL.Y)   -- Top
                lines[1].To = Vector2.new(TR.X, TR.Y)
                lines[2].From = Vector2.new(TL.X, TL.Y)   -- Left
                lines[2].To = Vector2.new(BL.X, BL.Y)
                lines[3].From = Vector2.new(TR.X, TR.Y)   -- Right
                lines[3].To = Vector2.new(BR.X, BR.Y)
                lines[4].From = Vector2.new(BL.X, BL.Y)   -- Bottom
                lines[4].To = Vector2.new(BR.X, BR.Y)

                local col = (target.TeamColor == plr.TeamColor) and settings.allyColor or settings.enemyColor
                for _, l in ipairs(lines) do
                    l.Color = col
                    l.Visible = true
                end
            else
                for _, l in ipairs(lines) do l.Visible = false end
            end
        else
            for _, l in ipairs(lines) do l.Visible = false end
        end
    end
end

RunService.RenderStepped:Connect(updateESP)

